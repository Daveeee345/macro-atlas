# Copy these values into Netlify environment variables and frontend/.env for Netlify Dev.
# Use the Supabase Transaction Pooler URI (port 6543) with SSL required.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
MACRO_ATLAS_SYNC_TOKEN=replace-with-a-long-random-secret
FRED_API_KEY=
MACRO_ATLAS_SERIES_CONFIG=[]

# Keep blank for same-origin Netlify Functions. Set only to test the reference FastAPI API.
NEXT_PUBLIC_API_BASE=
