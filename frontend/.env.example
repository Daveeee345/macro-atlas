# Leave blank for Netlify Dev and production. Requests use same-origin /api routes.
NEXT_PUBLIC_API_BASE=

# Supabase Transaction Pooler URI (port 6543, sslmode=require).
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Long random secret used only between the scheduler and background sync endpoint.
MACRO_ATLAS_SYNC_TOKEN=replace-with-a-long-random-secret

# Optional. Required only when an approved FRED mapping is configured.
FRED_API_KEY=

# JSON array of reviewed official-series mappings. Empty means sync safely does no work.
MACRO_ATLAS_SERIES_CONFIG=[]
